{
  "name": "stripes-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "validate": "node packages/builder/src/cli.js validate",
    "validate:all": "node packages/builder/src/cli.js validate --verbose",
    "build:palette": "npm run build -w @stripes-theme/palette",
    "build:ports": "node packages/builder/src/cli.js build",
    "build": "npm run build:palette && npm run build:ports",
    "check": "node packages/builder/src/cli.js check",
    "new": "node packages/builder/src/cli.js new",
    "package:vscode": "cd ports/vscode && npx -y @vscode/vsce@4.1.0 package --no-dependencies --out ../../stripes-vscode.vsix",
    "test": "node --test test/",
    "site:dev": "npm run dev -w @stripes-theme/site",
    "site:build": "npm run build -w @stripes-theme/site",
    "assets": "node scripts/render-assets.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
