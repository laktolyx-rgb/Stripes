{
  "name": "stripes-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "stripes-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@stripes-theme/builder": {
      "resolved": "packages/builder",
      "link": true
    },
    "node_modules/@stripes-theme/palette": {
      "resolved": "packages/palette",
      "link": true
    },
    "packages/builder": {
      "name": "@stripes-theme/builder",
      "version": "0.1.0",
      "bin": {
        "stripes": "src/cli.js"
      }
    },
    "packages/palette": {
      "name": "@stripes-theme/palette",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
