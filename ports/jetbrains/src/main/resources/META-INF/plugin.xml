<idea-plugin>
  <id>com.github.laktolyx-rgb.stripes</id>
  <name>Stripes Theme</name>
  <vendor url="https://github.com/laktolyx-rgb/stripes">Stripes</vendor>
  <description><![CDATA[
    A gothic black &amp; white theme with a single drop of blood.<br/>
    Four variants: <b>Night</b>, <b>Bone</b> (light), <b>Void</b> (OLED) and <b>Blood</b> (high contrast, WCAG AAA).
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="stripes-night" path="/themes/stripes_night.theme.json"/>
    <themeProvider id="stripes-bone" path="/themes/stripes_bone.theme.json"/>
    <themeProvider id="stripes-void" path="/themes/stripes_void.theme.json"/>
    <themeProvider id="stripes-blood" path="/themes/stripes_blood.theme.json"/>
  </extensions>
</idea-plugin>
