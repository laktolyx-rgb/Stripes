        "foreground": "#bdbdbd"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#787878",
        "fontStyle": "italic"
      }
    }
