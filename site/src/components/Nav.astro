---
import palette from '../generated/palette.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const variants = Object.values(palette.variants) as { id: string; name: string; colors: Record<string, { hex: string }> }[];
---
<nav class="nav">
  <div class="wrap inner">
    <a class="brand" href="#top"><img src={`${base}/brand/mark.svg`} alt="" width="28" height="28" /> Stripes</a>
    <div class="links">
      <a href="#palette">Palette</a>
      <a href="#playground">Playground</a>
      <a href="#ports">Ports</a>
      <a href="https://github.com/stripes-theme/stripes">GitHub</a>
    </div>
    <div class="picker" role="radiogroup" aria-label="Variant">
      {variants.map((v) => (
        <button role="radio" aria-checked="false" data-variant={v.id} title={v.name}
          style={`--sw-bg:${v.colors.midnight.hex};--sw-fg:${v.colors.bone.hex};--sw-acc:${v.colors.blood.hex}`}>
          <span class="sw" aria-hidden="true"></span><span class="label">{v.id}</span>
        </button>
      ))}
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50; backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--stripes-crypt) 85%, transparent); border-bottom: 1px solid var(--stripes-grave);
  }
  .inner { display: flex; align-items: center; gap: 24px; height: 60px; }
  .brand { display: flex; gap: 10px; align-items: center; font: 24px/1 var(--display); color: var(--stripes-ivory); text-decoration: none; }
  .links { display: flex; gap: 20px; margin-right: auto; }
  .links a { color: var(--stripes-smoke); text-decoration: none; font: 14px var(--mono); }
  .links a:hover { color: var(--stripes-accent); }
  .picker { display: flex; gap: 4px; border: 1px solid var(--stripes-grave); padding: 3px; }
  .picker button {
    display: flex; gap: 6px; align-items: center; padding: 6px 10px; border: 0; cursor: pointer;
    background: transparent; color: var(--stripes-fog); font: 12px/1 var(--mono); text-transform: capitalize;
  }
  .picker button[aria-checked='true'] { background: var(--stripes-tomb); color: var(--stripes-ivory); }
  .sw {
    width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--stripes-ash);
    background: linear-gradient(90deg, var(--sw-bg) 0 40%, var(--sw-fg) 40% 70%, var(--sw-acc) 70%);
  }
  @media (max-width: 760px) { .links { display: none; } .brand { margin-right: auto; } .label { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.picker button')];
  function setVariant(id: string, save = true) {
    root.dataset.stripes = id;
    buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.variant === id)));
    if (save) { try { localStorage.setItem('stripes-variant', id); } catch {} }
    dispatchEvent(new CustomEvent('stripes:variant', { detail: id }));
  }
  buttons.forEach((b) => b.addEventListener('click', () => setVariant(b.dataset.variant!)));
  setVariant(root.dataset.stripes || 'night', false);
  // keyboard: 1-4
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('textarea, input, select')) return;
    const i = Number(e.key) - 1;
    if (buttons[i]) setVariant(buttons[i].dataset.variant!);
  });
</script>
