---
import palette from '../generated/palette.json';
const order = palette.colorOrder as string[];
const night = (palette.variants as any).night;
---
<section id="palette">
  <div class="wrap">
    <p class="eyebrow">The palette</p>
    <h2>Twelve shades of the grave</h2>
    <p class="lede">Every port reads from a single <code>palette.json</code>. Each text color passes WCAG AA on Night, Bone and Void, and AAA on Blood. Click a color to copy it.</p>
    <div class="grid">
      {order.map((name) => (
        <button class="chip" data-color={name} style={`--c: var(--stripes-${name})`}>
          <span class="swatch"></span>
          <span class="meta"><b>{name}</b><code class="hex">{night.colors[name].hex}</code><small>{night.colors[name].doc}</small></span>
        </button>
      ))}
    </div>
    <p class="note" aria-live="polite"></p>
    <pre class="install"><code>npm i @stripes-theme/palette</code></pre>
  </div>
</section>

<script define:vars={{ variants: palette.variants }}>
  const update = () => {
    const v = variants[document.documentElement.dataset.stripes || 'night'];
    document.querySelectorAll('#palette .chip').forEach((el) => {
      el.querySelector('.hex').textContent = v.colors[el.dataset.color].hex;
    });
  };
  addEventListener('stripes:variant', update);
  update();
  document.querySelectorAll('#palette .chip').forEach((el) => el.addEventListener('click', async () => {
    const hex = el.querySelector('.hex').textContent;
    const note = document.querySelector('#palette .note');
    try { await navigator.clipboard.writeText(hex); note.textContent = `Copied ${el.dataset.color} ${hex}`; }
    catch { note.textContent = `${el.dataset.color}: ${hex}`; }
  }));
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .chip {
    display: flex; gap: 14px; align-items: center; padding: 12px; text-align: left; cursor: pointer;
    background: var(--stripes-crypt); border: 1px solid var(--stripes-grave); color: var(--stripes-foreground);
    font: inherit; transition: border-color .2s, transform .15s;
  }
  .chip:hover { border-color: var(--stripes-accent); transform: translateY(-2px); }
  .swatch { flex: none; width: 56px; height: 56px; background: var(--c); border: 1px solid var(--stripes-ash); }
  .meta { display: grid; gap: 2px; min-width: 0; }
  .meta b { font: 700 15px var(--mono); color: var(--stripes-ivory); }
  .meta code { font-size: 13px; color: var(--stripes-smoke); }
  .meta small { font-size: 13px; color: var(--stripes-fog); line-height: 1.3; }
  .note { font: 13px var(--mono); color: var(--stripes-accent); min-height: 1.5em; }
  .install { display: inline-block; padding: 12px 18px; background: var(--stripes-crypt); border-left: 3px solid var(--stripes-accent); color: var(--stripes-ivory); margin: 8px 0 0; }
</style>
