---
import data from '../generated/ports.json';
const repo = 'https://github.com/stripes-theme/stripes/tree/main/ports';
const order = ['editor', 'terminal', 'app'];
const ports = [...data.ports].sort((a, b) => order.indexOf(a.category) - order.indexOf(b.category) || a.name.localeCompare(b.name));
const md = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<section id="ports" class="box-office">
  <div class="wrap">
    <p class="kicker">Box office</p>
    <h2 class="gothic">Admit one, any window</h2>
    <p class="lede">{ports.length} apps, every one printed from the same palette. Missing yours? <code>npm run new -- your-app</code> and send a pull request.</p>
    <div class="grid">
      {ports.map((p, i) => (
        <a class="stub" href={`${repo}/${p.id}`} style={`--r:${((i * 41) % 7) - 3}deg`}>
          <span class="no">Nº {String(i + 1).padStart(3, '0')}</span>
          <span class="cat">{p.category}</span>
          <b>{p.name}</b>
          <span class="how" set:html={md(p.install ?? '')}></span>
          <span class="admit" aria-hidden="true">ADMIT ONE</span>
        </a>
      ))}
      <a class="stub you" href="https://github.com/stripes-theme/stripes/blob/main/CONTRIBUTING.md" style="--r:2deg">
        <span class="no">Nº ???</span><span class="cat">you</span><b>Your app here</b><span class="how">Read the contributing guide →</span>
        <span class="admit" aria-hidden="true">ADMIT ONE</span>
      </a>
    </div>
  </div>
</section>

<style>
  .box-office { padding: 120px 0; border-top: 2px dashed var(--stripes-grave); }
  .grid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 26px; }
  .stub {
    position: relative; display: grid; gap: 4px; align-content: start; padding: 20px 22px 20px 46px; min-height: 170px;
    color: var(--stripes-bone); text-decoration: none; background: var(--stripes-crypt); transform: rotate(var(--r));
    border: 2px solid var(--stripes-ash);
    /* perforated left edge */
    mask: radial-gradient(circle 6px at 0 12px, #0000 98%, #000) 0 0 / 100% 24px;
    transition: transform .15s steps(2);
  }
  .stub::before { content: ''; position: absolute; left: 28px; top: 8px; bottom: 8px; border-left: 2px dashed var(--stripes-ash); }
  .stub:hover { transform: rotate(0) translateY(-4px); border-color: var(--stripes-blood); color: var(--stripes-bone); }
  .no { font-size: 12px; color: var(--stripes-fog); }
  .cat { font-size: 11px; letter-spacing: .25em; text-transform: uppercase; color: var(--stripes-blood); }
  b { font: 700 30px/1.05 var(--gothic); color: var(--stripes-ivory); }
  .how { font-size: 14px; color: var(--stripes-smoke); line-height: 1.45; }
  .how :global(code) { font-size: 12px; color: var(--stripes-blood); word-break: break-word; }
  .admit { position: absolute; left: 6px; top: 50%; transform: translateY(-50%) rotate(180deg); writing-mode: vertical-rl; font-size: 10px; letter-spacing: .3em; color: var(--stripes-fog); }
  .you { border-style: dashed; }
</style>
