---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Scene from '../components/Scene.astro';
import Act from '../components/Act.astro';
import Palette from '../components/Palette.astro';
import Playground from '../components/Playground.astro';
import Ports from '../components/Ports.astro';
import TheEnd from '../components/TheEnd.astro';

const acts = [
  {
    variant: 'night', caption: 'In which the code goes dark, and only the strings bleed.', file: 'wake.ts', lang: 'typescript',
    note: 'The original. Charcoal, bone and blood. Keywords in bold ivory, comments in a fog of italics.',
    code: `// Act I: in which the code goes dark
import { candle } from './crypt';

interface Ghost { name: string; haunts: number }

export function wake(ghosts: Ghost[], hour = 13) {
  if (hour !== 13) throw new Error(\`too early, \${hour}\`);
  return ghosts.filter((g) => g.haunts > 0).map(candle);
}`,
  },
  {
    variant: 'bone', caption: 'In which the ink dries on old parchment.', file: 'ledger.py', lang: 'python',
    note: 'For daylight and printed pages. Dried-ink black on warm parchment, the blood darkened to stay legible.',
    code: `# Act II: the undertaker's ledger
from dataclasses import dataclass

@dataclass
class Grave:
    name: str
    depth: float = 6.0  # feet, by tradition

def unmarked(graves: list[Grave]) -> list[str]:
    """Names nobody wrote on a stone."""
    return [g.name for g in graves if not g.name.strip()]`,
  },
  {
    variant: 'void', caption: 'In which the pixels sleep in their coffins.', file: 'coffin.rs', lang: 'rust',
    note: 'True #000 for OLED screens. Every unlit pixel is switched off and resting in peace.',
    code: `// Act III: nothing but the void
#[derive(Debug)]
struct Coffin<'a> { owner: &'a str, nails: u8 }

impl Coffin<'_> {
    fn is_sealed(&self) -> bool {
        self.nails >= 13 // the traditional number
    }
}`,
  },
  {
    variant: 'blood', caption: 'In which every word can be read, even by the dead.', file: 'seance.go', lang: 'go',
    note: 'High contrast. Every token passes WCAG AAA, for tired eyes and low vision.',
    code: `// Act IV: a séance with perfect contrast
package seance

import "fmt"

func Summon(name string, candles int) error {
	if candles < 3 {
		return fmt.Errorf("%s will not come with %d candles", name, candles)
	}
	return nil
}`,
  },
] as const;
---
<Layout>
  <Nav />
  <Scene />
  {acts.map((a, i) => <Act n={i + 1} flip={i % 2 === 1} {...a} />)}
  <Palette />
  <Playground />
  <Ports />
  <TheEnd />
</Layout>
