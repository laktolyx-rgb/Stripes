---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Palette from '../components/Palette.astro';
import Playground from '../components/Playground.astro';
import Ports from '../components/Ports.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <Nav />
  <Hero />
  <div class="stripe-rule" aria-hidden="true"></div>

  <section id="acts">
    <div class="wrap acts">
      <div><p class="eyebrow">Act I</p><h3>Night</h3><p>The original. Charcoal <code>#101010</code>, bone text, one red thread.</p></div>
      <div><p class="eyebrow">Act II</p><h3>Bone</h3><p>Old parchment and dried ink, for daylight and printed pages.</p></div>
      <div><p class="eyebrow">Act III</p><h3>Void</h3><p>True <code>#000</code> black. Your OLED pixels sleep in their coffins.</p></div>
      <div><p class="eyebrow">Act IV</p><h3>Blood</h3><p>High contrast. Every token passes WCAG AAA.</p></div>
    </div>
  </section>

  <Palette />
  <Playground />
  <Ports />

  <footer>
    <div class="wrap foot">
      <img src={`${base}/brand/mark.svg`} alt="" width="40" height="40" />
      <p>Stripes is MIT licensed and made by people who like their themes the way they like their films: in black and white, with a little blood.<br />
        <a href="https://github.com/stripes-theme/stripes">GitHub</a> · <a href="https://www.npmjs.com/package/@stripes-theme/palette">npm</a> · Press <kbd>1</kbd>–<kbd>4</kbd> to switch variants.</p>
    </div>
  </footer>
</Layout>

<style>
  .acts { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
  .acts h3 { font: 400 34px/1 var(--display); margin: 0 0 8px; color: var(--stripes-ivory); }
  .acts p:not(.eyebrow) { color: var(--stripes-smoke); margin: 0; }
  footer { border-top: 1px solid var(--stripes-grave); padding: 48px 0 64px; background: var(--stripes-crypt); }
  .foot { display: flex; gap: 20px; align-items: flex-start; color: var(--stripes-fog); font-size: 16px; }
  .foot p { margin: 0; }
  kbd { font-size: 12px; border: 1px solid var(--stripes-ash); padding: 1px 5px; color: var(--stripes-foreground); }
</style>
