{
  "$schema": "./palette.schema.json",
  "name": "Stripes",
  "version": "0.1.0",
  "description": "A gothic black & white theme with a single drop of blood.",
  "colorOrder": ["midnight", "crypt", "grave", "tomb", "ash", "fog", "smoke", "bone", "ivory", "blood", "ember", "scar"],
  "colorDocs": {
    "midnight": "Main background",
    "crypt": "Secondary background: sidebars, panels, statusline",
    "grave": "Current line, borders, inactive tabs",
    "tomb": "Selection and hover background",
    "ash": "Decorations only (indent guides, rulers, inactive line numbers); not for text",
    "fog": "Comments and muted text",
    "smoke": "Functions, methods, secondary text",
    "bone": "Main foreground text",
    "ivory": "Keywords (bold), cursor, emphasis",
    "blood": "The single accent: strings, links, active indicators",
    "ember": "Errors, deleted lines, brighter accent",
    "scar": "Tinted background for accent: search matches, diff removed"
  },
  "variants": {
    "night": {
      "name": "Stripes Night",
      "dark": true,
      "description": "The original. Industrial blue-charcoal, bone and blood.",
      "colors": {
        "midnight": "#181c22",
        "crypt": "#1e232a",
        "grave": "#29303a",
        "tomb": "#353d49",
        "ash": "#5f6875",
        "fog": "#8c95a1",
        "smoke": "#c2c7ce",
        "bone": "#ececec",
        "ivory": "#ffffff",
        "blood": "#e36666",
        "ember": "#f07f7f",
        "scar": "#4a1f24"
      },
      "ansi": {
        "normal": { "black": "#29303a", "red": "#e36666", "green": "#b0b0b0", "yellow": "#d4d4d4", "blue": "#8f8f8f", "magenta": "#c27a7a", "cyan": "#9e9e9e", "white": "#ececec" },
        "bright": { "black": "#5f6875", "red": "#f07f7f", "green": "#c8c8c8", "yellow": "#e6e6e6", "blue": "#a8a8a8", "magenta": "#d69a9a", "cyan": "#b8b8b8", "white": "#ffffff" }
      }
    },
    "bone": {
      "name": "Stripes Bone",
      "dark": false,
      "description": "Old parchment and dried ink. The light variant.",
      "colors": {
        "midnight": "#ece7dc",
        "crypt": "#e3ddd0",
        "grave": "#d6cfbf",
        "tomb": "#c9c0ad",
        "ash": "#a39a88",
        "fog": "#626262",
        "smoke": "#3d3d3d",
        "bone": "#1a1a1a",
        "ivory": "#000000",
        "blood": "#a32b2b",
        "ember": "#8f1f1f",
        "scar": "#e6c9c4"
      },
      "ansi": {
        "normal": { "black": "#1a1a1a", "red": "#a32b2b", "green": "#4a4a4a", "yellow": "#3d3d3d", "blue": "#5e5e5e", "magenta": "#8a4a4a", "cyan": "#555555", "white": "#c9c0ad" },
        "bright": { "black": "#666666", "red": "#8f1f1f", "green": "#2e2e2e", "yellow": "#262626", "blue": "#454545", "magenta": "#733838", "cyan": "#3a3a3a", "white": "#a39a88" }
      }
    },
    "void": {
      "name": "Stripes Void",
      "dark": true,
      "description": "True black for OLED screens.",
      "colors": {
        "midnight": "#000000",
        "crypt": "#080808",
        "grave": "#121212",
        "tomb": "#1f1f1f",
        "ash": "#4d4d4d",
        "fog": "#787878",
        "smoke": "#bdbdbd",
        "bone": "#ececec",
        "ivory": "#ffffff",
        "blood": "#d15858",
        "ember": "#e57373",
        "scar": "#2e0f0f"
      },
      "ansi": {
        "normal": { "black": "#121212", "red": "#d15858", "green": "#b0b0b0", "yellow": "#d4d4d4", "blue": "#8f8f8f", "magenta": "#c27a7a", "cyan": "#9e9e9e", "white": "#ececec" },
        "bright": { "black": "#4d4d4d", "red": "#e57373", "green": "#c8c8c8", "yellow": "#e6e6e6", "blue": "#a8a8a8", "magenta": "#d69a9a", "cyan": "#b8b8b8", "white": "#ffffff" }
      }
    },
    "blood": {
      "name": "Stripes Blood",
      "dark": true,
      "description": "High contrast on oxblood black. Every token passes WCAG AAA.",
      "colors": {
        "midnight": "#0f0405",
        "crypt": "#170708",
        "grave": "#240c0e",
        "tomb": "#401215",
        "ash": "#8a8a8a",
        "fog": "#b3b3b3",
        "smoke": "#e0e0e0",
        "bone": "#ffffff",
        "ivory": "#ffffff",
        "blood": "#ff6b6b",
        "ember": "#ff8a8a",
        "scar": "#5c1519"
      },
      "ansi": {
        "normal": { "black": "#240c0e", "red": "#ff6b6b", "green": "#d0d0d0", "yellow": "#e8e8e8", "blue": "#b3b3b3", "magenta": "#ff9e9e", "cyan": "#c4c4c4", "white": "#ffffff" },
        "bright": { "black": "#8a8a8a", "red": "#ff8a8a", "green": "#e0e0e0", "yellow": "#f5f5f5", "blue": "#cccccc", "magenta": "#ffbdbd", "cyan": "#d9d9d9", "white": "#ffffff" }
      }
    }
  },
  "roles": {
    "background":      { "color": "midnight" },
    "backgroundAlt":   { "color": "crypt" },
    "lineHighlight":   { "color": "grave" },
    "border":          { "color": "grave" },
    "selection":       { "color": "tomb" },
    "guide":           { "color": "ash" },
    "foreground":      { "color": "bone" },
    "foregroundMuted": { "color": "fog" },
    "cursor":          { "color": "ivory" },
    "accent":          { "color": "blood" },
    "accentBackground":{ "color": "scar" },

    "keyword":         { "color": "ivory", "bold": true },
    "storage":         { "color": "ivory", "bold": true },
    "function":        { "color": "smoke" },
    "method":          { "color": "smoke" },
    "type":            { "color": "bone", "italic": true },
    "variable":        { "color": "bone" },
    "parameter":       { "color": "bone", "italic": true },
    "property":        { "color": "smoke" },
    "constant":        { "color": "ivory" },
    "number":          { "color": "ivory" },
    "string":          { "color": "blood" },
    "regex":           { "color": "ember" },
    "escape":          { "color": "ember", "bold": true },
    "operator":        { "color": "smoke" },
    "punctuation":     { "color": "fog" },
    "comment":         { "color": "fog", "italic": true },
    "tag":             { "color": "ivory", "bold": true },
    "attribute":       { "color": "smoke", "italic": true },

    "error":           { "color": "ember" },
    "warning":         { "color": "ivory" },
    "info":            { "color": "smoke" },
    "hint":            { "color": "fog" },
    "diffAdded":       { "color": "bone" },
    "diffRemoved":     { "color": "ember" },
    "diffChanged":     { "color": "smoke" }
  },
  "contrast": {
    "codeRoles": ["foreground", "foregroundMuted", "keyword", "function", "type", "constant", "number", "string", "regex", "operator", "punctuation", "comment", "tag", "attribute", "error", "warning", "info", "hint", "accent"],
    "surfaces": ["background", "backgroundAlt"],
    "selectionRoles": ["foreground", "keyword", "function"],
    "min": { "default": 4.5, "blood": 7.0 },
    "ansiMin": 3.0
  }
}
